# =============================================================================
# 셀프마케팅 플랫폼 — 환경 변수 예시
# 실제 값은 .env.local 에 설정하세요. (이 파일은 placeholder 만 포함)
# =============================================================================

# --- 사이트 ------------------------------------------------------------------
# robots.txt / sitemap.xml / OG 메타에 사용되는 프로덕션 도메인.
NEXT_PUBLIC_SITE_URL=https://selfmarketing.example

# GitHub Pages 등 하위 경로(/<repo>)로 배포할 때만 설정. (예: /automarketing)
# 루트 도메인 배포 시에는 비워 둡니다. 배포 워크플로가 자동 주입합니다.
NEXT_PUBLIC_BASE_PATH=

# --- 인증 + 캐시(포인트) 백엔드: Supabase --------------------------------------
# 두 값을 채우면 회원가입/로그인과 캐시 지갑이 자동으로 실제 Supabase로 전환됩니다.
# 비워두면 로컬 stub 모드로 동작합니다. (docs/SUPABASE_SETUP.md 참고)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 결제(PG) — 포인트 충전. 현재는 미연동(테스트 충전) -------------------------
# TODO(payment): PortOne(아임포트) 등 PG 연동 시 사용. 실제 결제는 서버 검증 필요.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# --- AI 블로그 원고 작성 ------------------------------------------------------
# 생성 API(서버 프록시) 엔드포인트. 비우면 데모(샘플) 모드로 동작합니다.
# 예: https://<project>.supabase.co/functions/v1/blog-writer (docs/AI_BLOG_SETUP.md)
NEXT_PUBLIC_BLOG_API_URL=
# 아래는 서버(Edge Function) 전용 시크릿 — 클라이언트에 절대 노출 금지(여기 두지 말 것).
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set BLOG_MODEL=claude-opus-4-8

# --- 전환 추적 (Conversion tracking) ---------------------------------------
# 하나의 GTM 컨테이너에서 GA4 + Meta Pixel 을 함께 관리합니다.
# 미설정 시 track() 이벤트는 콘솔 로그로 대체됩니다.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 아래 두 값은 GTM 컨테이너 내부 태그 설정에서 사용합니다.
# (코드에서 직접 로드하지 않지만, 운영/문서화를 위해 함께 정리)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- 카카오 로그인 (Kakao OAuth) — 현재는 stub --------------------------------
# TODO(backend): 실제 OAuth 토큰 교환 구현 시 사용.
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key
NEXT_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# --- 백엔드 API (Backend) — 현재는 stub --------------------------------------
# TODO(backend): 인증, 광고, 환급, 진단 API 연동 시 사용.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
