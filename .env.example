# =============================================================================
# 셀프마케팅 플랫폼 — 환경 변수 예시
# 실제 값은 .env.local 에 설정하세요. (이 파일은 placeholder 만 포함)
# =============================================================================

# --- 전환 추적 (Conversion tracking) ---------------------------------------
# 하나의 GTM 컨테이너에서 GA4 + Meta Pixel 을 함께 관리합니다.
# 미설정 시 track() 이벤트는 콘솔 로그로 대체됩니다.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 아래 두 값은 GTM 컨테이너 내부 태그 설정에서 사용합니다.
# (코드에서 직접 로드하지 않지만, 운영/문서화를 위해 함께 정리)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- 카카오 로그인 (Kakao OAuth) — 현재는 stub --------------------------------
# TODO(backend): 실제 OAuth 토큰 교환 구현 시 사용.
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key
NEXT_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# --- 백엔드 API (Backend) — 현재는 stub --------------------------------------
# TODO(backend): 인증, 광고, 환급, 진단 API 연동 시 사용.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
